# Sorour Mohamed — Portfolio & Admin Dashboard Environment Variables
# Copy this file to .env and fill in real values before running in production.
# NEVER commit real secrets or passwords to Git.

PORT=8080
HOST=0.0.0.0
DB_PATH=./data/portfolio.db
UPLOAD_DIR=./uploads
SITE_URL=https://sorourmohamed.com

# Initial Super Admin bootstrap credentials (used only on first seed if no admin exists)
# Change password immediately after first login!
ADMIN_NAME=Sorour Mohamed
ADMIN_EMAIL=admin@sorourmohamed.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_INITIAL_PASSWORD

# Optional External Integrations (leave blank until configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GA_MEASUREMENT_ID=
META_PIXEL_ID=
WHATSAPP_NUMBER=
